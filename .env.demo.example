# Compose deployment coordinates. Use an immutable commit-SHA image tag.
ARCA_IMAGE=000000000000.dkr.ecr.us-east-1.amazonaws.com/arca-demo:COMMIT_SHA
DEMO_HOSTNAME=api.example.com

# API runtime
NODE_ENV=production
PORT=8080
SOURCE_MODE=live
STORAGE_BACKEND=supabase
WEBSITE_EVIDENCE_PROVIDER=rules
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
SESSION_TOKEN_SECRET=
APIFY_API_TOKEN=
OPENAI_API_KEY=
CORS_ALLOWED_ORIGINS=https://arcacover.com,http://localhost:3000
TRUST_PROXY_HOPS=1
MAX_DIRECTORY_TARGETS=2
MAX_APIFY_CONCURRENCY=2
