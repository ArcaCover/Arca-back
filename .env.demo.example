# Compose deployment coordinates. Use an immutable commit-SHA image tag.
ARCA_IMAGE=000000000000.dkr.ecr.us-east-1.amazonaws.com/arca-demo:COMMIT_SHA
DEMO_HOSTNAME=api.example.com

# Basic auth for /docs and /openapi.json. Generate the hash on the host with:
#   docker run --rm -it caddy:2.10.2-alpine caddy hash-password
# Compose interpolates this file, so double every '

# API runtime
NODE_ENV=production
PORT=8080
SOURCE_MODE=live
STORAGE_BACKEND=supabase
WEBSITE_EVIDENCE_PROVIDER=nvidia
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Agentic extraction endpoint: nvidia or openai. openai needs OPENAI_API_KEY and SIGNAL_LLM_MODEL (e.g. gpt-4.1-mini).
SIGNAL_LLM_ENDPOINT=nvidia
SIGNAL_LLM_MODEL=
# Optional for OpenAI reasoning models: none|minimal|low|medium|high (support varies by model).
SIGNAL_LLM_REASONING_EFFORT=
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
SESSION_TOKEN_SECRET=
APIFY_API_TOKEN=
OPENAI_API_KEY=
CORS_ALLOWED_ORIGINS=https://arcacover.com,https://staging.arcacover.com,http://localhost:3000
TRUST_PROXY_HOPS=1
MAX_APIFY_CONCURRENCY=2
APIFY_ACTOR_BUILD=latest
APIFY_MAX_COST_USD_PER_RUN=1
APIFY_MAX_COST_USD_PER_SCAN=10
APIFY_MAX_COST_USD_PER_DAY=100
APIFY_QUERY_CACHE_TTL_MS=86400000
APIFY_ACTIVE_RUN_TTL_MS=900000
APIFY_RUN_TIMEOUT_SECS=300
APIFY_BAR_TARGETED_MAX_RESULTS=25
APIFY_AVVO_TARGETED_MAX_RESULTS=10
APIFY_MAX_CACHED_ITEMS=1000
PIPELINE_TIMEOUT_MS=600000

# Domain scan cache window. Layer 1 evidence changes in weeks, not hours.
SCAN_CACHE_TTL_MS=604800000
 of the hash: $2a$14$... becomes $2a$14$...
DOCS_AUTH_USER=arca
DOCS_AUTH_HASH=

