# Non-secret configuration of the pilot API (live-debug). It ships inside the pilot image, like production.env.
# Secrets live in SSM under /arca/pilot/ (scripts/arca-pilot-secrets.ps1): SESSION_TOKEN_SECRET, APIFY_API_TOKEN,
# OPENAI_API_KEY, PILOT_ACCESS_TOKEN, and the local database's POSTGRES_PASSWORD, AUTHENTICATOR_PASSWORD,
# PGRST_JWT_SECRET and SUPABASE_SECRET_KEY (a service_role JWT signed with PGRST_JWT_SECRET).

PILOT_HOSTNAME=api-pilot.arcacover.com
NODE_ENV=production
ARCA_MODE=live-debug
# The one deployment where live-debug may run. It requires PILOT_ACCESS_TOKEN: every request but /health must carry it.
ARCA_DEPLOYMENT=aws-pilot
PORT=8080
SOURCE_MODE=live
# PostgREST over pilot's own Postgres (compose.pilot.yaml sets SUPABASE_URL), never production's database.
STORAGE_BACKEND=supabase
WEBSITE_EVIDENCE_PROVIDER=agentic
SIGNAL_LLM_MODEL=gpt-6-luna
CORS_ALLOWED_ORIGINS=https://pilot.arcacover.com,http://localhost:3000
# Accounts and payments are simulated in memory in live-debug; nothing reaches Supabase Auth or Stripe.
WEBAPP_PROVIDERS=simulated
APP_BASE_URL=https://pilot.arcacover.com
TRUST_PROXY_HOPS=1

# Pilot spends real money on every uncached scan: a small ceiling of its own, tracked in its own database.
APIFY_SPEND_CEILING_USD=5
MAX_APIFY_CONCURRENCY=4
APIFY_ACTOR_BUILD=latest
APIFY_EXPECTED_COST_USD_PER_RUN=1
APIFY_EXPECTED_COST_USD_PER_TARGETED_RUN=0.1
APIFY_AVVO_EXPECTED_COST_USD_PER_TARGETED_RUN=0.4
APIFY_ACTIVE_RUN_TTL_MS=900000
APIFY_RUN_TIMEOUT_SECS=300
APIFY_BAR_TARGETED_MAX_RESULTS=25
APIFY_AVVO_TARGETED_MAX_RESULTS=10
APIFY_BAR_OFFICE_SAMPLE_MAX_RESULTS=20
APIFY_AVVO_OFFICE_SAMPLE_MAX_RESULTS=10
APIFY_MAX_CACHED_ITEMS=1000
PIPELINE_TIMEOUT_MS=600000
SCAN_CACHE_TTL_MS=604800000
APIFY_QUERY_CACHE_TTL_MS=604800000
SCAN_PARTIAL_REPAIR_COOLDOWN_MS=3600000
