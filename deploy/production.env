# Non-secret runtime configuration of the production API. It ships inside the image, so a
# deploy or a rollback always runs with the configuration of its own commit.
#
# Secrets never go here. They live in SSM Parameter Store under /arca/prod/, one SecureString
# per variable named after it (for example /arca/prod/APIFY_API_TOKEN), and deploy-image.sh
# merges them in on the host. See docs/deployment/AWS_DEMO_RUNBOOK.md.

DEMO_HOSTNAME=api.arcacover.com
DOCS_AUTH_USER=arca

NODE_ENV=production
PORT=8080
SOURCE_MODE=live
STORAGE_BACKEND=supabase
# Multi-round website extraction through OpenAI, the same as local development. Needs
# /arca/prod/OPENAI_API_KEY.
WEBSITE_EVIDENCE_PROVIDER=agentic
SIGNAL_LLM_MODEL=gpt-6-luna
CORS_ALLOWED_ORIGINS=https://arcacover.com,https://staging.arcacover.com,http://localhost:3000
# Caddy is the only ingress, so the client address is one hop back.
TRUST_PROXY_HOPS=1

MAX_APIFY_CONCURRENCY=16
APIFY_ACTOR_BUILD=latest
APIFY_EXPECTED_COST_USD_PER_RUN=1
APIFY_ACTIVE_RUN_TTL_MS=900000
APIFY_RUN_TIMEOUT_SECS=300
APIFY_BAR_TARGETED_MAX_RESULTS=25
APIFY_AVVO_TARGETED_MAX_RESULTS=10
APIFY_MAX_CACHED_ITEMS=1000
PIPELINE_TIMEOUT_MS=600000

# Kept in step: if the Apify query cache expired first, repairing a partial scan would
# re-pay the directory runs it was meant to reuse.
SCAN_CACHE_TTL_MS=604800000
APIFY_QUERY_CACHE_TTL_MS=604800000
SCAN_PARTIAL_REPAIR_COOLDOWN_MS=3600000
