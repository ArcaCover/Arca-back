# Non-secret runtime configuration of the production API. It ships inside the image, so a
# deploy or a rollback always runs with the configuration of its own commit.
#
# Secrets never go here. They live in SSM Parameter Store under /arca/prod/, one SecureString
# per variable named after it (for example /arca/prod/APIFY_API_TOKEN), and deploy-image.sh
# merges them in on the host. See docs/deployment/AWS_DEMO_RUNBOOK.md.

DEMO_HOSTNAME=api.arcacover.com
# The pilot API, served by this Caddy once the pilot project runs (deploy/pilot). Its DNS record points at this host.
PILOT_HOSTNAME=api-pilot.arcacover.com
DOCS_AUTH_USER=arca

NODE_ENV=production
# Marks the image as deployed, so the API refuses any debug ARCA_MODE (DN-09). ARCA_MODE stays unset: production.
ARCA_DEPLOYMENT=aws
PORT=8080
SOURCE_MODE=live
STORAGE_BACKEND=supabase
# Multi-round website extraction through OpenAI, the same as local development. Needs
# /arca/prod/OPENAI_API_KEY.
WEBSITE_EVIDENCE_PROVIDER=agentic
SIGNAL_LLM_MODEL=gpt-6-luna
CORS_ALLOWED_ORIGINS=https://arcacover.com,https://staging.arcacover.com,http://localhost:3000
# The private webapp is on with Stripe in TEST mode (founder decision, 2026-11-20): accounts are real, payments are not; a
# real card is declined and the 4242 test card activates an organization. The Stripe and Resend secrets live in SSM.
# Back to 501 on every webapp route: WEBAPP_ENABLED=false. Live billing: a live key in SSM and STRIPE_ALLOW_TEST_MODE=false.
WEBAPP_ENABLED=true
STRIPE_ALLOW_TEST_MODE=true
APP_BASE_URL=https://arcacover.com
# Invitation emails go through Resend's API (DN-13 F11), from the domain Supabase Auth's SMTP already sends from. The key
# is a secret: /arca/prod/RESEND_API_KEY (scripts/arca-webapp-secrets.ps1). Read only once the webapp is on.
EMAIL_PROVIDER=resend
EMAIL_FROM=ARCA <no-reply@arcacover.com>
# Caddy is the only ingress, so the client address is one hop back.
TRUST_PROXY_HOPS=1

MAX_APIFY_CONCURRENCY=16
APIFY_ACTOR_BUILD=latest
APIFY_EXPECTED_COST_USD_PER_RUN=1
APIFY_EXPECTED_COST_USD_PER_TARGETED_RUN=0.1
APIFY_AVVO_EXPECTED_COST_USD_PER_TARGETED_RUN=0.4
APIFY_ACTIVE_RUN_TTL_MS=900000
APIFY_RUN_TIMEOUT_SECS=300
APIFY_BAR_TARGETED_MAX_RESULTS=25
APIFY_AVVO_TARGETED_MAX_RESULTS=10
APIFY_BAR_OFFICE_SAMPLE_MAX_RESULTS=20
APIFY_AVVO_OFFICE_SAMPLE_MAX_RESULTS=10
APIFY_MAX_CACHED_ITEMS=1000
PIPELINE_TIMEOUT_MS=600000

# Kept in step: if the Apify query cache expired first, repairing a partial scan would
# re-pay the directory runs it was meant to reuse.
SCAN_CACHE_TTL_MS=604800000
APIFY_QUERY_CACHE_TTL_MS=604800000
SCAN_PARTIAL_REPAIR_COOLDOWN_MS=3600000
