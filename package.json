{
  "name": "arca-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @arca/api",
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:container": "node scripts/container-smoke.mjs",
    "db:new": "supabase migration new",
    "db:push": "supabase db push"
    ,"db:verify": "tsx --conditions=development apps/api/scripts/verify-supabase.ts",
    "demo:signals": "tsx --conditions=development apps/api/scripts/demo-signals.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
