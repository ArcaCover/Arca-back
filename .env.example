NODE_ENV=development
PORT=8080

# Backend-only credentials. Never expose service role or API keys to clients.
SUPABASE_URL=https://gyyilhdxhighrtrxsyim.supabase.co
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_SERVICE_ROLE_KEY is also accepted if SUPABASE_SECRET_KEY is empty.
SESSION_TOKEN_SECRET=
OPENAI_API_KEY=
APIFY_API_TOKEN=

# Exact allowed origins, separated by commas.
CORS_ALLOWED_ORIGINS=https://arcacover.com,http://localhost:3000

# Configure sources and storage independently. Supabase + mock needs no OpenAI/Apify keys.
SOURCE_MODE=mock
STORAGE_BACKEND=memory

# Zero uses the direct connection IP. Configure only behind a known trusted proxy.
TRUST_PROXY_HOPS=0
