NODE_ENV=development
PORT=8080

# Backend-only credentials. Never expose service role or API keys to clients.
SUPABASE_URL=https://gyyilhdxhighrtrxsyim.supabase.co
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_SERVICE_ROLE_KEY is also accepted if SUPABASE_SECRET_KEY is empty.
SESSION_TOKEN_SECRET=
OPENAI_API_KEY=
APIFY_API_TOKEN=

# Deterministic extraction is the default. Set openai only when semantic extraction is desired.
WEBSITE_EVIDENCE_PROVIDER=nvidia
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Agentic extraction endpoint: nvidia or openai. openai needs OPENAI_API_KEY and SIGNAL_LLM_MODEL (e.g. gpt-4.1-mini).
SIGNAL_LLM_ENDPOINT=nvidia
SIGNAL_LLM_MODEL=
# Optional for OpenAI reasoning models: none|minimal|low|medium|high (support varies by model).
SIGNAL_LLM_REASONING_EFFORT=

# Exact allowed origins, separated by commas.
CORS_ALLOWED_ORIGINS=https://arcacover.com,http://localhost:3000

# Configure sources and storage independently. Supabase + mock needs no OpenAI/Apify keys.
SOURCE_MODE=mock
STORAGE_BACKEND=memory

# Zero uses the direct connection IP. Configure only behind a known trusted proxy.
TRUST_PROXY_HOPS=0

# Limit concurrent Apify runs; per-run and per-scan budgets below contain total spend.
MAX_APIFY_CONCURRENCY=2
APIFY_ACTOR_BUILD=latest
APIFY_MAX_COST_USD_PER_RUN=1
APIFY_MAX_COST_USD_PER_SCAN=10
APIFY_MAX_COST_USD_PER_DAY=100
APIFY_QUERY_CACHE_TTL_MS=86400000
APIFY_ACTIVE_RUN_TTL_MS=900000
APIFY_RUN_TIMEOUT_SECS=300
APIFY_BAR_TARGETED_MAX_RESULTS=25
APIFY_AVVO_TARGETED_MAX_RESULTS=10
APIFY_MAX_CACHED_ITEMS=1000
PIPELINE_TIMEOUT_MS=600000
