
NODE_ENV=development
PORT=8080

# Supabase: el backend usa la service role key porque las tablas están cerradas a anon en Fase 1.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Secreto del session_token (JWT HS256, 24h). Mínimo 32 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_TOKEN_SECRET=

# Orígenes permitidos por CORS, separados por comas. Se admite un comodín de subdominio.
CORS_ALLOWED_ORIGINS=https://arcacover.com,https://*.vercel.app,http://localhost:3000
