NODE_ENV=development
PORT=8080

# Backend-only credentials. Never expose service role or API keys to clients.
SUPABASE_URL=https://gyyilhdxhighrtrxsyim.supabase.co
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_SERVICE_ROLE_KEY is also accepted if SUPABASE_SECRET_KEY is empty.
SESSION_TOKEN_SECRET=
OPENAI_API_KEY=
APIFY_API_TOKEN=

# Website extraction: agentic (default, multi-round through OpenAI), openai (earlier single pass)
# or rules (deterministic, no language model). agentic and openai need OPENAI_API_KEY.
WEBSITE_EVIDENCE_PROVIDER=agentic
# OpenAI model of the agentic extraction. Empty means gpt-6-luna.
SIGNAL_LLM_MODEL=
# Optional for OpenAI reasoning models: none|minimal|low|medium|high (support varies by model).
SIGNAL_LLM_REASONING_EFFORT=

# Exact allowed origins, separated by commas.
CORS_ALLOWED_ORIGINS=https://arcacover.com,https://staging.arcacover.com,http://localhost:3000
# Where the front serves the webapp (invitation links, billing return URLs). Defaults to http://localhost:3000.
# APP_BASE_URL=http://localhost:3000

# Developer mode, same value as NEXT_PUBLIC_ARCA_MODE in the front. Absent means production; any other
# value than the three below stops the start. See docs/design-notes/DN-09-modos-mock-y-live-debug.md.
#   production  (default when absent) exactly the configuration below, no debug routes
#   mock        forces SOURCE_MODE=mock, STORAGE_BACKEND=memory and ASSESSMENT_PLANNER=rules, no keys needed
#   live-debug  forces nothing: needs SOURCE_MODE=live and STORAGE_BACKEND=supabase with their keys
# Both debug modes listen on 127.0.0.1 only and refuse to start where ARCA_DEPLOYMENT is set.
# This example starts a fresh checkout in mock. `npm run dev:mock`, `npm run dev:live-debug` and
# `npm run stack -- <mode>` set the mode themselves and win over this line.
ARCA_MODE=mock

# Configure sources and storage independently. Supabase + mock needs no OpenAI/Apify keys.
SOURCE_MODE=mock
STORAGE_BACKEND=memory

# Zero uses the direct connection IP. Configure only behind a known trusted proxy.
TRUST_PROXY_HOPS=0

# Limit concurrent Apify runs. Spend is recorded in the ledger, never capped.
MAX_APIFY_CONCURRENCY=16
APIFY_ACTOR_BUILD=latest
# Provisional cost booked while a run is in flight, before Apify reports the real figure.
APIFY_EXPECTED_COST_USD_PER_RUN=1
# Keep in step with SCAN_CACHE_TTL_MS or repairing a partial scan re-pays directory runs.
APIFY_QUERY_CACHE_TTL_MS=604800000
APIFY_ACTIVE_RUN_TTL_MS=900000
APIFY_RUN_TIMEOUT_SECS=300
APIFY_BAR_TARGETED_MAX_RESULTS=25
APIFY_AVVO_TARGETED_MAX_RESULTS=10
APIFY_MAX_CACHED_ITEMS=1000
PIPELINE_TIMEOUT_MS=600000

# Domain scan cache window. Layer 1 evidence changes in weeks, not hours.
SCAN_CACHE_TTL_MS=604800000
# A PARTIAL scan is repaired at most once per this window; inside it the last repair is served.
SCAN_PARTIAL_REPAIR_COOLDOWN_MS=3600000

# Layer 2 fixture assessment. Rules is free; agent is explicit opt-in in live mode only.
# The demo bank and 30/70 composite are NOT approved underwriting rules.
ASSESSMENT_PLANNER=rules
