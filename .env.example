NODE_ENV=development
PORT=8080

# Backend-only credentials. Never expose service role or API keys to clients.
SUPABASE_URL=https://gyyilhdxhighrtrxsyim.supabase.co
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_SERVICE_ROLE_KEY is also accepted if SUPABASE_SECRET_KEY is empty.
SESSION_TOKEN_SECRET=
OPENAI_API_KEY=
APIFY_API_TOKEN=

# Website extraction: agentic (default, multi-round through OpenAI), openai (earlier single pass)
# or rules (deterministic, no language model). agentic and openai need OPENAI_API_KEY.
WEBSITE_EVIDENCE_PROVIDER=agentic
# OpenAI model of the agentic extraction. Empty means gpt-6-luna.
SIGNAL_LLM_MODEL=
# Optional for OpenAI reasoning models: none|minimal|low|medium|high (support varies by model).
SIGNAL_LLM_REASONING_EFFORT=

# Exact allowed origins, separated by commas.
CORS_ALLOWED_ORIGINS=https://arcacover.com,https://staging.arcacover.com,http://localhost:3000
# Where the front serves the webapp (invitation links, billing return URLs). Defaults to http://localhost:3000.
# APP_BASE_URL=http://localhost:3000

# The private webapp (DN-13 §3.2, §7.1). The debug modes serve the simulated one (in memory, mock login and payment) by
# default; WEBAPP_PROVIDERS=real in live-debug uses Supabase Auth and the Supabase project above, and needs a Stripe test key
# and its webhook secret. mock never runs the real providers. Production switches the webapp on with WEBAPP_ENABLED=true;
# without it every webapp route answers 501. A live Stripe key (sk_live_/rk_live_) never loads outside production.
# Supabase tokens are checked against the project's JWKS: there is no JWT secret to set.
# WEBAPP_PROVIDERS=simulated
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Invitation emails: memory keeps them in the process (the debug modes' default); resend sends them through Resend's API
# (production's, needs RESEND_API_KEY); ses through Amazon SES (the alternative). Only the real webapp sends for real:
# live-debug with WEBAPP_PROVIDERS=real may set EMAIL_PROVIDER=resend for one real test. EMAIL_FROM defaults to
# ARCA <no-reply@arcacover.com>.
# EMAIL_PROVIDER=memory
# EMAIL_FROM=ARCA <no-reply@arcacover.com>
# Resend API key (re_...), read only with EMAIL_PROVIDER=resend. Production keeps it in SSM, /arca/prod/RESEND_API_KEY.
# RESEND_API_KEY=

# Developer mode, same value as NEXT_PUBLIC_ARCA_MODE in the front. Absent means production; any other
# value than the three below stops the start. See docs/design-notes/DN-09-modos-mock-y-live-debug.md.
#   production  (default when absent) exactly the configuration below, no debug routes
#   mock        forces SOURCE_MODE=mock, STORAGE_BACKEND=memory and ASSESSMENT_PLANNER=rules, no keys needed
#   live-debug  forces nothing: needs SOURCE_MODE=live and STORAGE_BACKEND=supabase with their keys
# Both debug modes listen on 127.0.0.1 only and refuse to start where ARCA_DEPLOYMENT is set.
# This example starts a fresh checkout in mock. `npm run dev:mock`, `npm run dev:live-debug` and
# `npm run stack -- <mode>` set the mode themselves and win over this line.
ARCA_MODE=mock

# Configure sources and storage independently. Supabase + mock needs no OpenAI/Apify keys.
SOURCE_MODE=mock
STORAGE_BACKEND=memory

# Zero uses the direct connection IP. Configure only behind a known trusted proxy.
TRUST_PROXY_HOPS=0

# Limit concurrent Apify runs. Spend is recorded in the ledger; only a spend ceiling (below) caps it.
MAX_APIFY_CONCURRENCY=16
APIFY_ACTOR_BUILD=latest
# Provisional cost booked for a run until Apify reports what it really charged, minutes after it ends.
# Provisional cost booked for a firm search: every lawyer of a firm, in the whole registry or in one office city.
APIFY_EXPECTED_COST_USD_PER_RUN=1
# Booked for a targeted lookup of a few named lawyers instead (DN-06 §10). Avvo returns up to ten detailed lawyers
# per lookup and costs more, so it has its own figure. Under a ceiling, each is also the most that run may charge.
APIFY_EXPECTED_COST_USD_PER_TARGETED_RUN=0.1
APIFY_AVVO_EXPECTED_COST_USD_PER_TARGETED_RUN=0.4
# Spend guards (DN-12 §5). Leave both empty: production then caps nothing, and live-debug uses its defaults,
# USD 2 of Apify runs per 24 hours and 30 OpenAI requests per scan. Set a number to change either one.
# APIFY_SPEND_CEILING_USD=0 starts no Apify run at all and still serves the queries already cached.
# The ceiling counts every run not settled yet at its reservation, so with the defaults two firm searches or
# about a dozen named lookups fit until their charges settle (about three minutes). For a large roster, raise it.
APIFY_SPEND_CEILING_USD=
OPENAI_MAX_REQUESTS_PER_SCAN=
# Keep in step with SCAN_CACHE_TTL_MS or repairing a partial scan re-pays directory runs.
APIFY_QUERY_CACHE_TTL_MS=604800000
APIFY_ACTIVE_RUN_TTL_MS=900000
APIFY_RUN_TIMEOUT_SECS=300
APIFY_BAR_TARGETED_MAX_RESULTS=25
APIFY_AVVO_TARGETED_MAX_RESULTS=10
APIFY_BAR_OFFICE_SAMPLE_MAX_RESULTS=20
APIFY_AVVO_OFFICE_SAMPLE_MAX_RESULTS=10
APIFY_MAX_CACHED_ITEMS=1000
PIPELINE_TIMEOUT_MS=600000

# Domain scan cache window. Layer 1 evidence changes in weeks, not hours.
SCAN_CACHE_TTL_MS=604800000
# Only a PARTIAL scan with a passing failure (a deadline, a provider) is run again, at most once per this
# window. A PARTIAL whose gaps a second scan would find again is served for the whole cache window.
SCAN_PARTIAL_REPAIR_COOLDOWN_MS=3600000
# How old a stored website analysis may be and still replace a new extraction of the same evidence (30 days).
WEBSITE_SIGNAL_REUSE_MAX_AGE_MS=2592000000
# To force a fresh run of a firm already in the cache, start the API once with these values set in the shell
# (they win over this file) and scan it: SCAN_CACHE_TTL_MS=1 SCAN_PARTIAL_REPAIR_COOLDOWN_MS=0, plus
# WEBSITE_SIGNAL_REUSE_MAX_AGE_MS=0 to make the model read the site again. See DN-12 §4.4.

# Layer 2 fixture assessment. Rules is free; agent is explicit opt-in in live mode only.
# The demo bank and 30/70 composite are NOT approved underwriting rules.
ASSESSMENT_PLANNER=rules
